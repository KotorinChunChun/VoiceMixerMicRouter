{
  "plugin_id": "voicemixer.rvc.cuda",
  "name": "VoiceMixer RVC CUDA",
  "version": "0.1.0",
  "api_version": 1,
  "category": "voice_conversion",
  "execution_mode": "process",
  "input_ports": [
    {
      "id": "audio_in",
      "name": "Audio In",
      "direction": "input",
      "required": true,
      "max_connections": 1
    }
  ],
  "output_ports": [
    {
      "id": "audio_out",
      "name": "Audio Out",
      "direction": "output",
      "required": true,
      "max_connections": null
    }
  ],
  "parameters": [
    {
      "id": "model",
      "label": "音声モデル",
      "kind": "file",
      "default": "models/KahoA.pth",
      "min": null,
      "max": null,
      "options": ["models/KahoA.pth", "models/KahoB.pth"],
      "description": "RVC音声モデル（.pth）。Plugin配下の相対Pathまたは絶対Pathを指定します。",
      "group": "モデル",
      "unit": "",
      "step": null,
      "restart_required": true
    },
    {
      "id": "index",
      "label": "検索Index",
      "kind": "file",
      "default": "models/Kaho.index",
      "min": null,
      "max": null,
      "options": ["models/Kaho.index"],
      "description": "Feature Index（.index）。Index Rateが0の場合は使用しません。",
      "group": "モデル",
      "unit": "",
      "step": null,
      "restart_required": true
    },
    {
      "id": "pitch",
      "label": "ピッチ",
      "kind": "number",
      "default": 0.0,
      "min": -24.0,
      "max": 24.0,
      "options": [],
      "description": "声の高さを半音単位で変更します。",
      "group": "音声",
      "unit": "半音",
      "step": 0.1,
      "restart_required": false
    },
    {
      "id": "formant",
      "label": "フォルマント",
      "kind": "number",
      "default": 0.0,
      "min": -12.0,
      "max": 12.0,
      "options": [],
      "description": "声質のフォルマントを変更します。",
      "group": "音声",
      "unit": "",
      "step": 0.01,
      "restart_required": false
    },
    {
      "id": "f0_method",
      "label": "F0抽出方式",
      "kind": "enum",
      "default": "fcpe",
      "min": null,
      "max": null,
      "options": ["fcpe", "rmvpe", "crepe", "harvest", "pm"],
      "description": "ピッチ抽出アルゴリズムを選択します。RMVPEは専用Assetが必要です。",
      "group": "音声",
      "unit": "",
      "step": null,
      "restart_required": false
    },
    {
      "id": "index_rate",
      "label": "Index適用率",
      "kind": "number",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "options": [],
      "description": "Feature Indexを変換結果へ混ぜる割合です。0で無効です。",
      "group": "音声",
      "unit": "",
      "step": 0.01,
      "restart_required": false
    },
    {
      "id": "block_time",
      "label": "推論ブロック長",
      "kind": "number",
      "default": 0.25,
      "min": 0.05,
      "max": 1.5,
      "options": [],
      "description": "1回のRVC推論で処理する音声長です。大きいほど安定しますが遅延が増えます。",
      "group": "処理時間",
      "unit": "秒",
      "step": 0.01,
      "restart_required": true
    },
    {
      "id": "crossfade_time",
      "label": "クロスフェード",
      "kind": "number",
      "default": 0.05,
      "min": 0.01,
      "max": 0.15,
      "options": [],
      "description": "SOLAで推論ブロックを接続するCrossfade長です。",
      "group": "処理時間",
      "unit": "秒",
      "step": 0.01,
      "restart_required": true
    },
    {
      "id": "extra_time",
      "label": "追加推論時間",
      "kind": "number",
      "default": 2.5,
      "min": 0.05,
      "max": 5.0,
      "options": [],
      "description": "推論へ渡す追加Context長です。",
      "group": "処理時間",
      "unit": "秒",
      "step": 0.05,
      "restart_required": true
    },
    {
      "id": "rms_mix_rate",
      "label": "音量包絡の混合率",
      "kind": "number",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "options": [],
      "description": "入力と変換後音声のRMS Envelopeを混合する割合です。",
      "group": "音量・ゲート",
      "unit": "",
      "step": 0.01,
      "restart_required": false
    },
    {
      "id": "threshold_db",
      "label": "入力Threshold",
      "kind": "number",
      "default": -60.0,
      "min": -60.0,
      "max": 0.0,
      "options": [],
      "description": "入力Gateの閾値です。-60 dBでGateを無効にします。",
      "group": "音量・ゲート",
      "unit": "dB",
      "step": 1.0,
      "restart_required": false
    },
    {
      "id": "n_cpu",
      "label": "CPU Worker数",
      "kind": "integer",
      "default": 4,
      "min": 1,
      "max": 4,
      "options": [],
      "description": "ピッチ抽出で使用するCPU Workerの最大数です。",
      "group": "詳細",
      "unit": "",
      "step": 1.0,
      "restart_required": true
    },
    {
      "id": "use_jit",
      "label": "JITを使用",
      "kind": "boolean",
      "default": false,
      "min": null,
      "max": null,
      "options": [],
      "description": "RVCのJITモデル経路を使用します。",
      "group": "詳細",
      "unit": "",
      "step": null,
      "restart_required": true
    },
    {
      "id": "input_noise_reduction",
      "label": "入力ノイズ抑制",
      "kind": "boolean",
      "default": false,
      "min": null,
      "max": null,
      "options": [],
      "description": "RVC推論前にCUDA Spectral Gateを適用します。",
      "group": "ノイズ抑制",
      "unit": "",
      "step": null,
      "restart_required": false
    },
    {
      "id": "output_noise_reduction",
      "label": "出力ノイズ抑制",
      "kind": "boolean",
      "default": false,
      "min": null,
      "max": null,
      "options": [],
      "description": "RVC変換後にCUDA Spectral Gateを適用します。",
      "group": "ノイズ抑制",
      "unit": "",
      "step": null,
      "restart_required": false
    },
    {
      "id": "transient_noise_suppression",
      "label": "短い衝撃音の抑制",
      "kind": "boolean",
      "default": false,
      "min": null,
      "max": null,
      "options": [],
      "description": "既存の推論履歴で無音に挟まれた短い衝撃音を判定し、対応する変換後の区間を抑制します。追加の音声待ちは設けません。声の近くや後続音が不足する区間は通します。",
      "group": "ノイズ抑制",
      "unit": "",
      "step": null,
      "restart_required": false
    }
  ],
  "audio": {
    "preferred_sample_rate": 48000,
    "preferred_channels": 2,
    "preferred_block_frames": 480,
    "minimum_block_frames": 64,
    "maximum_block_frames": 4096
  },
  "default_enabled": false,
  "process": {
    "executable": "runtime/python.exe",
    "arguments": ["rvc_plugin.py"],
    "start_timeout_ms": 120000
  }
}
